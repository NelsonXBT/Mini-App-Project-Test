generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoProvider {
  youtube
  bunny
}

enum ResourceType {
  pdf
  download
  google_doc
  drive
  github
  website
  notion
  zip
  link
  other
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum ActivityType {
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DELETED

  MODULE_CREATED
  MODULE_UPDATED
  MODULE_DELETED

  LESSON_CREATED
  LESSON_UPDATED
  LESSON_DELETED
  LESSON_DUPLICATED

  RESOURCE_CREATED
  RESOURCE_UPDATED
  RESOURCE_DELETED

  COURSE_FILE_CREATED
  COURSE_FILE_UPDATED
  COURSE_FILE_DELETED

  STUDENT_ENROLLED
  STUDENT_UNENROLLED
  PROGRESS_RESET

  SETTINGS_UPDATED

  COMMUNITY_CHANNEL_CREATED
  COMMUNITY_CHANNEL_UPDATED
  COMMUNITY_CHANNEL_DELETED

  RESOURCE_ITEM_CREATED
  RESOURCE_ITEM_UPDATED
  RESOURCE_ITEM_DELETED

  NOTIFICATION_CREATED
  NOTIFICATION_UPDATED
  NOTIFICATION_DELETED
}

// Which tab of the student Resources page an item belongs to.
enum ResourceSection {
  packs
  tools
}

enum NotificationAudience {
  ALL
  COURSE
}

model User {
  id         String  @id @default(cuid())
  telegramId BigInt  @unique
  username   String?
  firstName  String
  lastName   String?
  email      String?
  photoUrl   String?
  isAdmin    Boolean @default(false)

  enrollments Enrollment[]
  progress    LessonProgress[]

  sessions Session[]

  // Everything created after this instant counts as unread. Null means the
  // student has never opened the panel, so their whole feed is unread.
  notificationsSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model Course {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  description      String?
  shortDescription String?
  thumbnail        String?
  purchaseUrl      String?

  // Authored by hand, never derived from lesson durations.
  manualDuration String?

  instructor String?
  difficulty Difficulty?

  isFree Boolean  @default(true)
  price  Decimal?

  isPublished Boolean @default(false)

  // Telegram Protection
  telegramChatId     String?
  telegramUsername   String?
  telegramInviteLink String?

  modules     Module[]
  enrollments Enrollment[]
  files       CourseFile[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id    String @id @default(cuid())
  title String
  order Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres does not index foreign keys automatically. Every course page
  // loads its modules by courseId, and every cascade delete scans for them.
  @@index([courseId])
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?

  provider VideoProvider
  videoId  String
  duration Int?

  // Defaults to true so every lesson that existed before this migration
  // stays visible to students without a backfill.
  isPublished Boolean @default(true)
  isPreview   Boolean @default(false)

  order Int

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Enrollment {
  id String @id @default(cuid())

  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status         EnrollmentStatus @default(ACTIVE)
  lastCheckedAt  DateTime?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  // courseId is the trailing column of the unique above, so a per-course
  // lookup (the admin student counts) cannot use it.
  @@index([courseId])
}

model LessonProgress {
  id String @id @default(cuid())

  userId   String
  lessonId String

  completed Boolean @default(false)

  // Playback state
  currentTime Int   @default(0)
  progress    Float @default(0)

  lastWatchedAt DateTime?
  completedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  // userId needs no index of its own — it leads the unique above, which
  // Postgres can use for userId-only lookups. lessonId does not, so joins
  // from a lesson to its progress rows have nothing to use.
  @@index([lessonId])
}

model Resource {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title     String
  type      ResourceType
  url       String
  sortOrder Int          @default(1)

  createdAt DateTime @default(now())

  @@index([lessonId])
}

model CourseFile {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String

  type ResourceType

  url String

  sortOrder Int @default(1)

  createdAt DateTime @default(now())

  @@index([courseId])
}

// ============================================================
// ADMIN
//
// Kept separate from User on purpose: User requires a unique
// telegramId, so an administrator who never opens the Mini App
// cannot be represented there.
// ============================================================

model AdminUser {
  id String @id @default(cuid())

  username     String @unique
  passwordHash String

  name String?

  lastLoginAt DateTime?

  sessions   AdminSession[]
  activities ActivityLog[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id String @id @default(cuid())

  token String @unique

  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([adminId])
}

// `summary` is denormalised deliberately. A "Lesson Deleted" entry has to
// outlive the row it describes, so the feed cannot be derived from the
// createdAt/updatedAt columns on the content tables.
model ActivityLog {
  id String @id @default(cuid())

  type    ActivityType
  summary String

  entityType String?
  entityId   String?

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// STUDENT-FACING CONTENT
//
// Community channels and resource items were hardcoded arrays in
// lib/constants. They live here so an admin can edit them
// without a deploy.
//
// `icon` stores a key, not a class name or an SVG: the student
// card maps it to a Lucide component and a colour. An unknown
// key falls back rather than rendering nothing, so renaming an
// icon in code cannot blank a live card.
// ============================================================

model CommunityChannel {
  id String @id @default(cuid())

  title       String
  description String
  icon        String @default("community")

  // The verb on the button ("Join", "Open", "Chat"). Per-channel because
  // joining a group and messaging support are not the same action.
  cta String @default("Open")

  url String

  isPublished Boolean @default(true)
  sortOrder   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ResourceItem {
  id String @id @default(cuid())

  section ResourceSection

  title       String
  description String
  icon        String @default("folder")

  cta String @default("Browse")

  url String

  // Packs show a file count; tools show an affiliate disclosure. Both are
  // optional because neither applies to the other section.
  fileCount   Int?
  isAffiliate Boolean @default(false)

  isPublished Boolean @default(true)
  sortOrder   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, sortOrder])
}

// ============================================================
// NOTIFICATIONS
//
// In-app only. Unread state is derived from
// User.notificationsSeenAt rather than stored per row, so there
// is no join table and no write on read.
// ============================================================

model Notification {
  id String @id @default(cuid())

  title String
  body  String

  audience NotificationAudience @default(ALL)

  // Set only when audience is COURSE. Cascades, because a notification
  // addressed to the students of a deleted course has no audience left.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Optional tap-through target for the student card.
  linkUrl String?

  // Drafts are invisible to students. Separate from createdAt so an admin can
  // write a notification now and release it later.
  publishedAt DateTime?

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The student feed both filters and orders on publishedAt.
  @@index([publishedAt])
  @@index([courseId])
  @@index([actorId])
}

// Single row, addressed by a fixed id.
model PlatformSettings {
  id String @id @default("singleton")

  platformName           String  @default("Nadi Academy")
  logoUrl                String?
  supportEmail           String?
  telegramCommunityUrl   String?
  defaultCourseThumbnail String?

  updatedAt DateTime @updatedAt
}

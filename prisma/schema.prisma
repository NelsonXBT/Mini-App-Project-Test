generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoProvider {
  youtube
  bunny
}

enum ResourceType {
  pdf
  download
  google_doc
  drive
  github
  website
  notion
  zip
  link
  other
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum ActivityType {
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DELETED

  MODULE_CREATED
  MODULE_UPDATED
  MODULE_DELETED

  LESSON_CREATED
  LESSON_UPDATED
  LESSON_DELETED
  LESSON_DUPLICATED

  RESOURCE_CREATED
  RESOURCE_UPDATED
  RESOURCE_DELETED

  COURSE_FILE_CREATED
  COURSE_FILE_UPDATED
  COURSE_FILE_DELETED

  STUDENT_ENROLLED
  STUDENT_UNENROLLED
  PROGRESS_RESET

  SETTINGS_UPDATED

  COMMUNITY_CHANNEL_CREATED
  COMMUNITY_CHANNEL_UPDATED
  COMMUNITY_CHANNEL_DELETED

  RESOURCE_ITEM_CREATED
  RESOURCE_ITEM_UPDATED
  RESOURCE_ITEM_DELETED

  NOTIFICATION_CREATED
  NOTIFICATION_UPDATED
  NOTIFICATION_DELETED

  BROADCAST_SENT

  TELEGRAM_DESTINATION_CREATED
  TELEGRAM_DESTINATION_UPDATED
  TELEGRAM_DESTINATION_DELETED
}

// Which tab of the student Resources page an item belongs to.
enum ResourceSection {
  packs
  tools
}

enum NotificationAudience {
  ALL
  COURSE
}

model User {
  id         String  @id @default(cuid())
  telegramId BigInt  @unique
  username   String?
  firstName  String
  lastName   String?
  email      String?
  photoUrl   String?
  isAdmin    Boolean @default(false)

  enrollments Enrollment[]
  progress    LessonProgress[]

  sessions Session[]

  /**
   * Messaging back-relations. Virtual only — Prisma requires the other side of
   * a relation to be named, but the foreign keys live on the messaging tables,
   * so neither of these adds a column to User.
   */
  broadcastsTargeted  BroadcastMessage[]
  broadcastDeliveries BroadcastDelivery[]

  // Everything created after this instant counts as unread. Null means the
  // student has never opened the panel, so their whole feed is unread.
  notificationsSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model Course {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  description      String?
  shortDescription String?
  thumbnail        String?
  purchaseUrl      String?

  // Authored by hand, never derived from lesson durations.
  manualDuration String?

  instructor String?
  difficulty Difficulty?

  isFree Boolean  @default(true)
  price  Decimal?

  isPublished Boolean @default(false)

  // Telegram Protection
  telegramChatId     String?
  telegramUsername   String?
  telegramInviteLink String?

  modules     Module[]
  enrollments Enrollment[]
  files       CourseFile[]

  notifications Notification[]

  // Messaging back-relation. Virtual only — the foreign key lives on
  // BroadcastMessage, so this adds no column to Course.
  broadcasts BroadcastMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id    String @id @default(cuid())
  title String
  order Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres does not index foreign keys automatically. Every course page
  // loads its modules by courseId, and every cascade delete scans for them.
  @@index([courseId])
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?

  provider VideoProvider
  videoId  String
  duration Int?

  // Defaults to true so every lesson that existed before this migration
  // stays visible to students without a backfill.
  isPublished Boolean @default(true)
  isPreview   Boolean @default(false)

  order Int

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Enrollment {
  id String @id @default(cuid())

  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status         EnrollmentStatus @default(ACTIVE)
  lastCheckedAt  DateTime?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  // courseId is the trailing column of the unique above, so a per-course
  // lookup (the admin student counts) cannot use it.
  @@index([courseId])
}

model LessonProgress {
  id String @id @default(cuid())

  userId   String
  lessonId String

  completed Boolean @default(false)

  // Playback state
  currentTime Int   @default(0)
  progress    Float @default(0)

  lastWatchedAt DateTime?
  completedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  // userId needs no index of its own — it leads the unique above, which
  // Postgres can use for userId-only lookups. lessonId does not, so joins
  // from a lesson to its progress rows have nothing to use.
  @@index([lessonId])
}

model Resource {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title     String
  type      ResourceType
  url       String
  sortOrder Int          @default(1)

  createdAt DateTime @default(now())

  @@index([lessonId])
}

model CourseFile {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String

  type ResourceType

  url String

  sortOrder Int @default(1)

  createdAt DateTime @default(now())

  @@index([courseId])
}

// ============================================================
// ADMIN
//
// Kept separate from User on purpose: User requires a unique
// telegramId, so an administrator who never opens the Mini App
// cannot be represented there.
// ============================================================

model AdminUser {
  id String @id @default(cuid())

  username     String @unique
  passwordHash String

  name String?

  lastLoginAt DateTime?

  sessions   AdminSession[]
  activities ActivityLog[]

  notifications Notification[]

  // Messaging back-relation. Virtual only — the foreign key lives on
  // BroadcastMessage, so this adds no column to AdminUser.
  broadcasts BroadcastMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id String @id @default(cuid())

  token String @unique

  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([adminId])
}

// `summary` is denormalised deliberately. A "Lesson Deleted" entry has to
// outlive the row it describes, so the feed cannot be derived from the
// createdAt/updatedAt columns on the content tables.
model ActivityLog {
  id String @id @default(cuid())

  type    ActivityType
  summary String

  entityType String?
  entityId   String?

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// STUDENT-FACING CONTENT
//
// Community channels and resource items were hardcoded arrays in
// lib/constants. They live here so an admin can edit them
// without a deploy.
//
// `icon` stores a key, not a class name or an SVG: the student
// card maps it to a Lucide component and a colour. An unknown
// key falls back rather than rendering nothing, so renaming an
// icon in code cannot blank a live card.
// ============================================================

model CommunityChannel {
  id String @id @default(cuid())

  title       String
  description String
  icon        String @default("community")

  // The verb on the button ("Join", "Open", "Chat"). Per-channel because
  // joining a group and messaging support are not the same action.
  cta String @default("Open")

  url String

  isPublished Boolean @default(true)
  sortOrder   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ResourceItem {
  id String @id @default(cuid())

  section ResourceSection

  title       String
  description String
  icon        String @default("folder")

  cta String @default("Browse")

  url String

  // Packs show a file count; tools show an affiliate disclosure. Both are
  // optional because neither applies to the other section.
  fileCount   Int?
  isAffiliate Boolean @default(false)

  isPublished Boolean @default(true)
  sortOrder   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, sortOrder])
}

// ============================================================
// NOTIFICATIONS
//
// In-app only. Unread state is derived from
// User.notificationsSeenAt rather than stored per row, so there
// is no join table and no write on read.
// ============================================================

model Notification {
  id String @id @default(cuid())

  title String
  body  String

  audience NotificationAudience @default(ALL)

  // Set only when audience is COURSE. Cascades, because a notification
  // addressed to the students of a deleted course has no audience left.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Optional tap-through target for the student card.
  linkUrl String?

  // Drafts are invisible to students. Separate from createdAt so an admin can
  // write a notification now and release it later.
  publishedAt DateTime?

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The student feed both filters and orders on publishedAt.
  @@index([publishedAt])
  @@index([courseId])
  @@index([actorId])
}

// Single row, addressed by a fixed id.
model PlatformSettings {
  id String @id @default("singleton")

  platformName           String  @default("Nadi Academy")
  logoUrl                String?
  supportEmail           String?
  telegramCommunityUrl   String?
  defaultCourseThumbnail String?

  updatedAt DateTime @updatedAt
}

// ============================================================
// TELEGRAM MESSAGING / BROADCAST
//
// Entirely additive, and deliberately READ-ONLY with respect to
// the existing student/course/access system. Recipient
// resolution reads Enrollment.status; nothing here ever writes
// it. Course access continues to be decided solely by
// /api/telegram-login via lib/telegram/checkMembership.ts.
//
// TelegramDestination is NOT a course-access channel. Course
// gating lives on Course.telegramChatId and is untouched by
// anything in this section — editing a destination cannot
// change who can open a course.
// ============================================================

enum BroadcastAudience {
  // Every student with at least one ACTIVE enrollment. "Active" is exactly
  // that and nothing more: it says nothing about when the student last opened
  // the Mini App. A student dormant for a year with an ACTIVE enrolment is a
  // valid recipient.
  ALL_ACTIVE_STUDENTS

  // Students whose enrollment in one specific course is ACTIVE.
  COURSE_ACTIVE_STUDENTS

  // One deliberately chosen student. Intentionally NOT filtered on active
  // enrollment — an admin who picks a specific person means that person.
  SPECIFIC_STUDENT

  // A configured channel or group, addressed by TelegramDestination.
  DESTINATION
}

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
}

enum BroadcastDeliveryStatus {
  PENDING
  SENT
  FAILED
  // Resolved as a recipient but unreachable — no usable Telegram chat id.
  // Never retried, and never a reason to alter the student's enrollment.
  SKIPPED
}

enum TelegramDestinationType {
  CHANNEL
  GROUP
}

/**
 * An authorised send target.
 * Exists so the frontend never submits a raw chat id: the composer posts a
 * destination id, and the server reads the chat id from this table. Managed
 * by admins only.
 */
model TelegramDestination {
  id String @id @default(cuid())

  name String

  // Telegram numeric chat id, e.g. -1001234567890. String because Telegram
  // channel ids exceed the safe integer range in JSON.
  chatId String @unique

  type TelegramDestinationType

  isActive Boolean @default(true)

  broadcasts BroadcastMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BroadcastMessage {
  id String @id @default(cuid())

  audience BroadcastAudience

  // Set only when audience is COURSE_ACTIVE_STUDENTS. SetNull rather than
  // Cascade: a sent broadcast is a historical record and must outlive the
  // course it was addressed to.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // Set only when audience is SPECIFIC_STUDENT.
  targetUserId String?
  targetUser   User?   @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  // Set only when audience is DESTINATION.
  destinationId String?
  destination   TelegramDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  // Every content field is optional — Telegram accepts a media-only message,
  // and a text-only message needs no image.
  title String?
  body  String?

  /**
   * Image metadata only. The binary lives in Vercel Blob; PostgreSQL holds
   * the reference. imageKey is the blob pathname, kept so the object can be
   * addressed later independently of the URL.
   */
  imageUrl      String?
  imageKey      String?
  imageMimeType String?
  imageSize     Int?

  /**
   * Inline keyboard as stored JSON: [{ text, action, url }].
   * Json rather than a child table because buttons are never queried across
   * broadcasts — they are read back only as part of this one message, and
   * rebuilt verbatim for the preview and for reply_markup.
   */
  buttons Json?

  status BroadcastStatus @default(DRAFT)

  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  // Nullable and SetNull: history outlives the admin account that sent it.
  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /*
   * Held while a send or resume pass is actively draining this message.
   *
   * A timestamp rather than a boolean so an abandoned lock expires: a
   * serverless function killed mid-pass can never release it, and without a
   * staleness window the broadcast would be unresumable forever. Any lock
   * older than the TTL in broadcast.ts is treated as abandoned and may be
   * reclaimed. Refreshed as the pass runs, so a live pass is never stolen.
   */
  lockedAt DateTime?

  deliveries BroadcastDelivery[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([courseId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([destinationId])
}

/**
 * Per-recipient delivery state.
 * Persisted before sending starts so a function timeout mid-broadcast leaves
 * an inspectable record rather than an unknown state: anything still PENDING
 * was not delivered. The unique constraint is also the duplicate-send guard —
 * one row per recipient per message, so a retry cannot double-send.
 */
model BroadcastDelivery {
  id String @id @default(cuid())

  messageId String
  message   BroadcastMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Null for channel/group sends, which have no User behind them.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Resolved chat id, snapshotted at send time. String for the same
  // JSON-safety reason as TelegramDestination.chatId.
  chatId String?

  status BroadcastDeliveryStatus @default(PENDING)

  // Telegram's own description on failure, e.g. "bot was blocked by the user".
  error String?

  /*
   * Whether this failure is worth another attempt.
   *
   * The transport already distinguishes a permanent rejection (403 blocked,
   * 400 chat not found) from a transient one (429, 5xx, network) — that
   * verdict was previously computed and thrown away. Persisting it is what
   * lets "retry failed" re-send only to recipients that might succeed, rather
   * than hammering accounts that have blocked the bot.
   */
  retryable Boolean @default(false)

  sentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([messageId, chatId])
  @@index([messageId])
  @@index([status])
  @@index([userId])
}
